# Скопируйте в .env и поправьте при необходимости.

# БД: SQLite по умолчанию (путь относительно папки prisma/).
DATABASE_URL="file:./dev.db"

# PostgreSQL (после установки Docker Desktop и `docker compose up -d`):
# DATABASE_URL="postgresql://javaquest:javaquest@localhost:5432/javaquest"

# Секрет Auth.js — сгенерируйте свой: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me"

# Продакшен (Railway и т.п.): доверять хосту, который выставляет платформа.
# AUTH_TRUST_HOST="true"

# Продакшен: строка подключения Postgres из сервиса Railway (Variables → Reference).
# DATABASE_URL="postgresql://user:pass@host:5432/railway"

# Бэкенд запуска кода: auto (локальный JDK, иначе Piston) | local | piston
RUNNER_BACKEND="auto"

# URL раннера кода (Piston). По умолчанию — локальный Docker-контейнер.
PISTON_API_URL="http://localhost:2000"

# Лимиты запуска кода
RUN_TIMEOUT_MS="5000"
RUN_MEMORY_LIMIT_MB="256"