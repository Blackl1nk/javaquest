# Скопируйте в .env и поправьте при необходимости.

# БД: SQLite по умолчанию (путь относительно папки prisma/).
DATABASE_URL="file:./dev.db"

# PostgreSQL (после установки Docker Desktop и `docker compose up -d`):
# DATABASE_URL="postgresql://javaquest:javaquest@localhost:5432/javaquest"

# Секрет Auth.js — сгенерируйте свой: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me"

# --- Переменные для хостинга (Vercel → Settings → Environment Variables) ---
# После добавления ОБЯЗАТЕЛЬНО сделай Redeploy, иначе они не применятся.

# 1) Строка подключения PostgreSQL (Neon/Supabase/Vercel Postgres).
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# 2) Доверять домену, который выдаёт платформа (без этого Auth.js: «Server error»).
# AUTH_TRUST_HOST="true"

# Бэкенд запуска кода:
#   auto   — локальный JDK, если он есть, иначе облачный Judge0 (по умолчанию)
#   local  — только JDK с этой машины (нужен javac в PATH)
#   judge0 — облачный Judge0 CE (для хостингов без JDK, например Vercel)
#   piston — своя песочница Piston в Docker (нужен PISTON_API_URL)
RUNNER_BACKEND="auto"

# Judge0 CE: публичный инстанс бесплатен и не требует ключа.
# Для нагрузки лучше поднять свой Judge0/Piston и указать свой адрес.
JUDGE0_URL="https://ce.judge0.com"
JUDGE0_JAVA_ID="91" # 91 = Java (JDK 17.0.6), 62 = OpenJDK 13

# URL своей песочницы Piston (используется только при RUNNER_BACKEND=piston).
PISTON_API_URL="http://localhost:2000"

# Лимиты запуска кода
RUN_TIMEOUT_MS="5000"
RUN_MEMORY_LIMIT_MB="256"